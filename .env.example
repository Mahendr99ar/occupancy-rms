# Copy to .env and change the secrets. Never commit .env.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Bearer token the dashboard asks for before approving or rejecting a rate.
API_TOKEN=change-me-long-random-string

# Optional: rate change explanations from an LLM. Without these the
# explanations come from a template built from the same facts.
# LLM_PROVIDER=anthropic          # or: openai (any OpenAI-compatible server, e.g. a local vLLM or Ollama)
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
